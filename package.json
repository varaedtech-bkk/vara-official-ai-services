{
  "name": "vara-ai-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "VARA EdTech real-time bilingual (EN/TH) AI voice assistant",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload vara-assistant --update-env",
    "pm2:stop": "pm2 stop vara-assistant",
    "pm2:logs": "pm2 logs vara-assistant --lines 50",
    "vapi:sync": "node scripts/sync-assistants.mjs",
    "vapi:print": "node scripts/sync-assistants.mjs --print",
    "leads:export": "node scripts/export-leads.mjs"
  },
  "dependencies": {
    "@vapi-ai/web": "^2.3.8",
    "next": "15.5.23",
    "nodemailer": "^9.0.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
