# ---------------------------------------------------------------------------
# VARA EdTech AI Assistant — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Public URL of THIS app. Must be https in production — the voice platform
# calls it for the search_knowledge and capture_lead tools, and will not call
# http:// or localhost.
NEXT_PUBLIC_SITE_URL=https://ai.varaedtech.com

# --- Voice platform keys ---------------------------------------------------

# Public key — safe in the browser, can only start a web call.
# Dashboard → Settings → API Keys → Public Key
VAPI_PUBLIC_KEY=cea88d43-d634-4e0a-b9d7-3ec61f3d35f4

# Private/server key — used ONLY by `npm run vapi:sync` to create and update
# the assistants. Never exposed to the browser.
# Dashboard → Settings → API Keys → Private Key
VAPI_PRIVATE_KEY=

# Filled in by `npm run vapi:sync` on first run — copy the printed IDs here so
# subsequent syncs update in place instead of creating duplicates.
VAPI_ASSISTANT_ID_EN=
VAPI_ASSISTANT_ID_TH=

# Shared secret sent as the x-vara-secret header on every tool webhook, so the
# API rejects anything that isn't the voice platform. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Re-run `npm run vapi:sync` after changing it.
VAPI_WEBHOOK_SECRET=

# --- Optional voice tuning -------------------------------------------------

# LLM behind the voice assistant. gpt-4o is the tested default.
# VAPI_LLM_MODEL=gpt-4o

# English voice (Vapi Voices V2). Male default: Elliot. Alternatives: Kai, Sid.
# VAPI_EN_VOICE_ID=Elliot

# Thai voice (Azure Neural). Male default: th-TH-NiwatNeural.
# Female alternative: th-TH-PremwadeeNeural, th-TH-AcharaNeural.
# VAPI_TH_VOICE_ID=th-TH-NiwatNeural

# --- Text chat fallback ----------------------------------------------------

# Powers the "prefer to type?" panel. Without it, the panel still answers
# directly from the knowledge base — degraded, but never dead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Leads -----------------------------------------------------------------

# Leads are appended to data/leads.jsonl in the repo. No extra directory needed.

# Token required to read /api/leads (API access). Leave blank to disable.
LEADS_ACCESS_TOKEN=

# Super admin adds paid client workspaces by hand (no payment provider yet).
# Each client gets /t/{slug} plus a dashboard login. They can change assistant
# name, logo, skills and their own SMTP details.
# DASHBOARD_PASSWORD remains the super-admin login (leave email blank).

# --- Follow-up email -------------------------------------------------------
#
# When a visitor gives their email during a voice conversation, Vara sends
# them an automatic confirmation email as soon as the lead is captured.
# Leave EMAIL_HOST blank to disable email sending entirely.
#
# Works with any SMTP provider (Gmail, Mailgun, SendGrid, AWS SES, etc.).
#
# Gmail example:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=you@gmail.com
#   EMAIL_PASS=your-app-password        # Gmail → Security → App Passwords
#
# SendGrid example:
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_USER=apikey
#   EMAIL_PASS=SG.xxxxxxxxxxxxxxxxxxxx
#
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Display name shown in the From: header. Defaults to EMAIL_USER if blank.
EMAIL_FROM=VARA EdTech <info@varaedtech.com>
# Optional: Reply-To address (so replies go to the right inbox).
EMAIL_REPLY_TO=info@varaedtech.com
